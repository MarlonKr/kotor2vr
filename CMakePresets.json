{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (host + tests)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "KOTORVR_ENABLE_OPENXR": "ON",
        "KOTORVR_WARNINGS_AS_ERRORS": "ON",
        "KOTOR2VR_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86 (game module + ABI tests)",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/x86",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "KOTOR2VR_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x86-release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}

